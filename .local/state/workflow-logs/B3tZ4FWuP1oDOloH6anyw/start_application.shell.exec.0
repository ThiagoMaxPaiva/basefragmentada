5:14:13 PM [express] GET /api/questions 200 in 22ms :: [{"id":198,"subject":"Portuguese","topic":"Interpretação de Texto","questionText":"No texto 'O pulo do gato', o autor afirma que o jornalismo é um equilíbrio entre razão e emoção. De acordo com o texto, o 'pulo do gato' no jornalismo consiste em:","options":["O uso excessivo de adjetivos para emocionar o leitor.","A predominância da sociologia sobre a narrativa dos fatos.","O equilíbrio entre a razão e a emoção na construção do texto.","A redação de textos puramente racionais para garantir a objetividade."],"correctOption":2,"explanation":"O texto afirma explicitamente que o 'pulo do gato' está no equilíbrio entre razão e emoção."},{"id":199,"subject":"Specialized IT Knowledge","topic":"Redes de Computadores","questionText":"No modelo de referência OSI (Open Systems Interconnection), qual camada é responsável pelo roteamento de pacotes através de diferentes redes, utilizando endereços lógicos (como o IP)?","options":["Camada de Enlace (Data Link Layer)","Camada de Rede (Network Layer)","Camada de Transporte (Transport Layer)","Camada de Sessão (Session Layer)"],"correctOption":1,"explanation":"A Camada de Rede (Camada 3) é responsável pelo endereçamento lógico e roteamento."},{"id":200,"subject":"Portuguese","topic":"Sintaxe","questionText":"Assinale a alternativa que apresenta a correta classificação sintática do termo em destaque na frase: 'No teu colo é o MEU ABRIGO'.","options":["Objeto Direto","Sujeito","Predicativo do Sujeito","Adjunto Adnominal"],"correctOption":1,"explanation":"Na ordem direta: 'O meu abrigo é no teu colo'. 'O meu abrigo' exerce a função de sujeito."},{"id":201,"subject":"Specialized IT Knowledge","topic":"Sistemas Operacionais","questionText":"Em sistemas operacionais baseados em Unix/Linux, qual comando é utilizado para alterar as permissões de acesso de um arquivo ou diretório?","options":["chown","chmod","chgrp","umask"],"correctOption":1,"explanation":"O comando 'chmod' (change mode) é utilizado para alterar as permissões de arquivos e diretórios."},{"id":202,"subject":"Specialized IT Knowledge","topic":"Linux","questionText":"Linux: Permissão '-rwxr-x---' em octal?","options":["750","751","754","777"],"correctOption":0,"explanation":"Dono(7)+Grupo(5)+Outros(0)."},{"id":203,"subject":"Portuguese","topic":"Gramática","questionText":"Regência 'Aspirar' (desejar)?","options":["VTD","VTI (exige 'a')","Intransitivo","VTI (exige 'de')"],"correctOption":1,"explanation":"Aspirar ao cargo."},{"id":204,"subject":"Specialized IT Knowledge","topic":"SQL","questionText":"SQL: Apagar tabela completa?","options":["DELETE","TRUNCATE","DROP","REMOVE"],"correctOption":2,"explanation":"DROP TABLE remove estrutura e dados."},{"id":205,"subject":"Specialized IT Knowledge","topic":"Geral","questionText":"Hosts em /27?","options":["32","30","16","14"],"correctOption":1,"explanation":"32 IPs - 2 = 30 Hosts."},{"id":206,"subject":"Portuguese","topic":"Gramática","questionText":"Crase obrigatória?","options":["Fui a pé","Vou à escola","Falei a ela","Venda a prazo"],"correctOption":1,"explanation":"Vou a + a escola."},{"id":207,"subject":"Specialized IT Knowledge","topic":"Geral","questionText":"Transporte confiável?","options":["UDP","IP","TCP","ICMP"],"correctOption":2,"explanation":"TCP garante entrega."},{"id":208,"subject":"Specialized IT Knowledge","topic":"Geral","questionText":"Diferença M.2 SATA vs NVMe?","options":["NVMe usa PCIe (rápido)","Iguais","SATA mais rápido","USB"],"correctOption":0,"explanation":"NVMe via PCIe é superior."},{"id":209,"subject":"Specialized IT Knowledge","topic":"Geral","questionText":"Selo 80 Plus?","options":["80% potência","Eficiência >= 80%","80 Volts","Durabilidade"],"correctOption":1,"explanation":"Eficiência energética."},{"id":210,"subject":"Specialized IT Knowledge","topic":"Geral","questionText":"Hyper-Threading?","options":["Overclock","2 threads por núcleo","Virtualização","Cache"],"correctOption":1,"explanation":"Simula n